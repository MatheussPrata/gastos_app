<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_config_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configurar Gráfico"
            android:textColor="@color/widget_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_config_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Escolha qual gráfico e período esse widget vai exibir na tela inicial."
            android:textColor="@color/widget_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="Tipo de gráfico"
            android:textColor="@color/widget_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rg_chart_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_bg_surface"
            android:orientation="vertical"
            android:padding="12dp">

            <RadioButton
                android:id="@+id/rb_chart_categories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="Gastos por categoria (rosca + top categorias)"
                android:textColor="@color/widget_text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rb_chart_balance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="Saldo ao longo do tempo (linha e área)"
                android:textColor="@color/widget_text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rb_chart_monthly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="Comparativo mensal (entradas vs saídas)"
                android:textColor="@color/widget_text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rb_chart_payment_methods"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="Formas de pagamento (Pix, crédito, débito...)"
                android:textColor="@color/widget_text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rb_chart_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="Gastos por cartão (uso do limite e faturas)"
                android:textColor="@color/widget_text_primary"
                android:textSize="14sp" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="Período analisado"
            android:textColor="@color/widget_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rg_chart_period"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_bg_surface"
            android:orientation="horizontal"
            android:padding="12dp">

            <RadioButton
                android:id="@+id/rb_period_month"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mês atual"
                android:textColor="@color/widget_text_primary"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rb_period_quarter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="3 meses"
                android:textColor="@color/widget_text_primary"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rb_period_year"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ano"
                android:textColor="@color/widget_text_primary"
                android:textSize="13sp" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/widget_bg_surface"
                android:text="Cancelar"
                android:textAllCaps="false"
                android:textColor="@color/widget_text_primary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/widget_btn_primary"
                android:text="Salvar widget"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
